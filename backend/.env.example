# ─────────────────────────────────────────────
# LinguaBridge Backend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# Groq API Key (get free at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# HuggingFace Spaces URL for the translation API
# After deploying the HF Space, paste the URL here
# Example: https://your-username-linguabridge-translate.hf.space
HF_SPACES_URL=

# CORS origins (comma-separated list of allowed frontend URLs)
# Update after deploying the frontend to Vercel
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# Models (defaults are pre-set, only change if needed)
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# GROQ_MODEL=llama-3.3-70b-versatile

# RAG settings (defaults are pre-set)
# CHUNK_SIZE=200
# CHUNK_OVERLAP=40
# TOP_K=5
