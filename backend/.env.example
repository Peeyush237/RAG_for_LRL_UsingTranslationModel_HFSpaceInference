# ─────────────────────────────────────────────
# LinguaBridge Backend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# Groq API Key (get free at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# HuggingFace Spaces URL for the translation API
HF_SPACES_URL=https://peeyush237-linguabridge-translate.hf.space

# HuggingFace Token (get at huggingface.co/settings/tokens)
# Avoids rate limits when downloading models
HF_TOKEN=hf_your_token_here

# CORS origins (update after deploying frontend to Vercel)
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# Enable CrossEncoder reranker (set to true if you have >512MB RAM)
# ENABLE_RERANKER=false

# Models (defaults are pre-set, only change if needed)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# GROQ_MODEL=llama-3.3-70b-versatile
